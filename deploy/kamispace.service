# systemd unit for KamiSpace.
#
#   sudo cp deploy/kamispace.service /etc/systemd/system/kamispace.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now kamispace
#
# Adjust User, WorkingDirectory and the path to uv to match your installation.

[Unit]
Description=KamiSpace knowledge workspace
After=network.target

[Service]
Type=simple
User=kamispace
Group=kamispace
WorkingDirectory=/opt/kamispace
Environment=KAMISPACE_ENV=production
# Worker processes: 1 for a small team, 2-4 (about one per CPU core) when many
# people work at the same time. Can also be set as KAMISPACE_WORKERS in .env.
#Environment=KAMISPACE_WORKERS=4
Environment=UV_CACHE_DIR=/opt/kamispace/.uv-cache
Environment=UV_PYTHON_INSTALL_DIR=/opt/kamispace/.python
# --frozen: use exactly the versions in uv.lock; --no-dev: skip test tooling.
ExecStart=/usr/local/bin/uv run --frozen --no-dev python -m app run
Restart=on-failure
RestartSec=3

# Hardening: the service only ever needs to write inside its own directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/kamispace
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
