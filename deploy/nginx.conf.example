# nginx reverse proxy for MindDock with HTTPS.
#
#   sudo cp deploy/nginx.conf.example /etc/nginx/sites-available/minddock
#   sudo ln -s /etc/nginx/sites-available/minddock /etc/nginx/sites-enabled/
#   sudo certbot --nginx -d notes.example.com      # obtains and installs a certificate
#   sudo nginx -t && sudo systemctl reload nginx
#
# Replace notes.example.com with your host name.

server {
    listen 80;
    listen [::]:80;
    server_name notes.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name notes.example.com;

    # certbot fills these in; shown here for a manually managed certificate.
    ssl_certificate     /etc/letsencrypt/live/notes.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/notes.example.com/privkey.pem;

    # Must be at least MINDDOCK_MAX_UPLOAD_MB (default 25), plus a little room.
    client_max_body_size 30m;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        # Large uploads and backup downloads are streamed, not buffered to disk.
        proxy_request_buffering off;
        proxy_buffering off;
    }
}
