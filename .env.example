# MindDock configuration. Copy to ".env" in the project root and adjust.
# Every setting has a sensible default; an empty file is a valid configuration.

# "development" or "production". Production hides the API docs and caches
# the frontend manifest.
MINDDOCK_ENV=production

# Address and port the server listens on. Keep 127.0.0.1 when a reverse proxy
# (nginx, Caddy) sits in front of MindDock — which is the recommended setup.
MINDDOCK_HOST=127.0.0.1
MINDDOCK_PORT=8000

# Where everything persistent lives: database, uploads, backups, logs, temp
# files. Relative paths are resolved against the project directory.
MINDDOCK_DATA_DIR=data

# Comma separated list of host names the site is served under. Requests with
# any other Host header are rejected. Leave empty to accept all.
MINDDOCK_ALLOWED_HOSTS=

# Session cookie "Secure" flag: auto (when the request arrived over HTTPS),
# always, or never. Use "always" in production behind HTTPS.
MINDDOCK_COOKIE_SECURE=auto

# Sessions end after this many minutes without activity, and at the latest
# after SESSION_MAX_DAYS.
MINDDOCK_SESSION_IDLE_MINUTES=10080
MINDDOCK_SESSION_MAX_DAYS=30

# Sign-in rate limiting: failed attempts allowed per account within the window.
MINDDOCK_LOGIN_MAX_FAILURES=5
MINDDOCK_LOGIN_WINDOW_MINUTES=15

# Largest accepted upload, in megabytes.
MINDDOCK_MAX_UPLOAD_MB=25

# Largest accepted document (the JSON of one page), in kilobytes.
MINDDOCK_MAX_DOCUMENT_KB=4096

# Autosaves by the same person within this many minutes are folded into one
# entry of the version history.
MINDDOCK_VERSION_INTERVAL_MINUTES=10

# Apply pending database migrations when the server starts.
MINDDOCK_AUTO_MIGRATE=true

MINDDOCK_LOG_LEVEL=INFO
